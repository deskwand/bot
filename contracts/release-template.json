{
  "schemaVersion": 1,
  "entrypoint": "index.js",
  "compatibility": {
    "date": "2026-11-01",
    "flags": ["nodejs_compat"]
  },
  "durableObjects": [
    { "name": "BUTLER", "className": "ButlerDO" },
    { "name": "TASK", "className": "TaskDO" },
    { "name": "BOT", "className": "BotDO" },
    { "name": "BOT_CHAT", "className": "BotChatDO" },
    { "name": "CHANNELS", "className": "ChannelDO" },
    { "name": "MCP_AUTH", "className": "McpAuthDO" },
    { "name": "LIFE", "className": "LifeDO" },
    { "name": "WALLET", "className": "WalletDO" }
  ],
  "r2Buckets": [
    { "name": "ARTIFACTS", "parameterKey": "r2BucketName" }
  ],
  "aiBindings": [{ "name": "AI" }],
  "versionMetadataBinding": { "name": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "configBinding": {
    "name": "DESKWAND_CONFIG",
    "type": "json",
    "schemaVersion": 1
  },
  "secretNamePatterns": ["^MODEL_KEY_[A-Z0-9_]{1,64}$", "^MCP_[A-Z0-9_]{1,64}$", "^SEARCH_KEY_[A-Z0-9_]{1,64}$", "^EXCHANGE_SECRET_[A-Z0-9_]{1,64}$"],
  "secretNames": [
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_WEBHOOK_SECRET",
    "WECHAT_CREDENTIALS",
    "ADMIN_TOKEN",
    "WALLET_PRIVATE_KEY",
    "WALLET_OWNER_ADDRESS"
  ],
  "plainVars": ["ACTIVE_CHANNEL", "PUBLIC_BASE_URL"],
  "crons": ["* * * * *"],
  "vars": [
    { "name": "PUBLIC_BASE_URL", "parameterKey": "PUBLIC_BASE_URL" }
  ],
  "migrations": [
    {
      "tag": "v1",
      "newSqliteClasses": ["ButlerDO", "TaskDO"]
    },
    {
      "tag": "v2",
      "newSqliteClasses": ["ChannelDO"]
    },
    {
      "tag": "v3",
      "newSqliteClasses": ["BotDO"]
    },
    {
      "tag": "v4",
      "newSqliteClasses": ["McpAuthDO"]
    },
    {
      "tag": "v5",
      "newSqliteClasses": ["BotChatDO"]
    },
    {
      "tag": "v6",
      "newSqliteClasses": ["LifeDO"]
    },
    {
      "tag": "v7",
      "newSqliteClasses": ["WalletDO"]
    }
  ],
  "installParameters": [
    { "key": "workerName", "source": "user" },
    { "key": "r2BucketName", "source": "user" },
    { "key": "PUBLIC_BASE_URL", "source": "user" },
    { "key": "owner", "source": "DESKWAND_CONFIG" }
  ]
}
