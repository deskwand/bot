# 复制为 .env 后填写（.env 已在 .gitignore 中）。
# docker compose 通过 env_file 注入；可选项留空即可。

# 必填：模型 key。每家厂商一个 MODEL_KEY_<ID>（id 转大写、- 换成 _）。
MODEL_KEY_OPENCODE_GO=

# 必填：admin 接口的 Bearer token。用随机长字符串，不要用示例值。
ADMIN_TOKEN=

# 入口渠道：telegram 或 wechat。
ACTIVE_CHANNEL=telegram

# 可选：其他模型厂商的 key，例如：
# MODEL_KEY_ANTHROPIC=
# MODEL_KEY_DEEPSEEK=
# SEARCH_KEY_TAVILY=
# SEARCH_KEY_BRAVE=

# Telegram 入口必填。
TELEGRAM_BOT_TOKEN=

# 可选：微信入口凭据（单行 JSON）。需要用仓库里的 `npm run wechat-login` 取得，
# 这一步需要 Node；也可以从已有的 wrangler secret 复制过来。
# WECHAT_CREDENTIALS={"token":"...","baseUrl":"https://ilinkai.weixin.qq.com","accountId":"...","userId":"..."}

# 必填：可管理配置（单行 JSON）。必须整体用单引号包住：compose 会去掉单引号，
# 且不做 $ 插值。把 owner 换成你的 Telegram 用户 ID。
DESKWAND_CONFIG='{"schemaVersion":1,"owner":{"telegramUserIds":[100000001]},"models":{"butler":{"provider":"opencode-go","id":"deepseek-v4.1-flash"},"task":{"provider":"opencode-go","id":"deepseek-v4.1-flash"}},"mcpServers":[]}'

# 可选：对外地址，默认 http://localhost:8787。只有需要远程 MCP 的 OAuth 回调，
# 或从别的机器访问 admin 接口时才设置；此时要自己加反向代理和 TLS。
# PUBLIC_BASE_URL=

# 可选：交易所只读账号（桌面端「交易所」页会自动写入；命令行部署时手填）。
# 每账号一个 secret，值是 JSON；OKX 需要 passphrase，Binance 不需要。
# EXCHANGE_SECRET_OKX_MAIN={"key":"...","secret":"...","passphrase":"..."}
# EXCHANGE_SECRET_BN_MAIN={"key":"...","secret":"..."}
