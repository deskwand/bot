{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://your-worker.workers.dev"
  },
  "keep_vars": true,
  "ai": { "binding": "AI" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "my-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BUTLER", "class_name": "ButlerDO" },
      { "name": "TASK", "class_name": "TaskDO" },
      { "name": "BOT", "class_name": "BotDO" },
      { "name": "BOT_CHAT", "class_name": "BotChatDO" },
      { "name": "CHANNELS", "class_name": "ChannelDO" },
      { "name": "MCP_AUTH", "class_name": "McpAuthDO" },
      { "name": "LIFE", "class_name": "LifeDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ButlerDO", "TaskDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChannelDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["BotDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["McpAuthDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["BotChatDO"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["LifeDO"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
