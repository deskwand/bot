{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://your-worker.workers.dev"
  },
  "keep_vars": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "my-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BUTLER", "class_name": "ButlerDO" },
      { "name": "TASK", "class_name": "TaskDO" },
      { "name": "CHANNELS", "class_name": "ChannelDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ButlerDO", "TaskDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChannelDO"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
