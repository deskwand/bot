# Copy to .dev.vars (git-ignored) for `npm run dev`.
# Production uses `wrangler secret put` for the secret values.
OPENCODE_API_KEY=replace-me
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me

# Optional WeChat iLink credentials written by `npm run wechat-login`
# (single-line JSON). Contains a bearer token: never commit or log it.
# WECHAT_CREDENTIALS={"token":"...","baseUrl":"https://...","accountId":"...","userId":"..."}

# Local-only channel selection. Production selection is managed by the
# publishing client and is intentionally absent from wrangler.jsonc.
ACTIVE_CHANNEL=telegram
