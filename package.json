{
  "name": "bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "predeploy": "node --use-env-proxy --experimental-strip-types scripts/check-remote-config.ts",
    "build:desktop": "bash scripts/build-desktop.sh",
    "release:desktop": "bash scripts/release-desktop.sh",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.ts --enforce 'desktop/frontend/src/**' --enforce 'desktop/internal/**' --enforce 'src/**'",
    "test": "npm run check:i18n && vitest run && vitest run --config vitest.node.config.ts",
    "test:node": "vitest run --config vitest.node.config.ts",
    "release:worker": "node --experimental-strip-types scripts/build-worker-release.ts",
    "release:sign": "node --experimental-strip-types scripts/sign-worker-release.ts",
    "generate:release-key": "node --experimental-strip-types scripts/generate-release-key.ts",
    "do-usage": "node --use-env-proxy --experimental-strip-types scripts/do-usage.ts",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "wechat-login": "node --use-env-proxy --experimental-strip-types scripts/wechat-login.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.4",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@silvia-odwyer/photon": "0.3.3",
    "@sinclair/typebox": "0.34.52",
    "agents": "0.32.0",
    "telegram-md-entities": "0.7.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "qrcode-terminal": "^0.12.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "workerd": "1.20261101.1"
  }
}
