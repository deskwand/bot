{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot",
  "main": "tests/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "PUBLIC_BASE_URL": "https://example.com",
    "ACTIVE_CHANNEL": "telegram",
    "DESKWAND_CONFIG": {
      "schemaVersion": 1,
      "owner": { "telegramUserIds": [100000001] },
      "models": {
        "butler": { "provider": "opencode-go", "id": "deepseek-v4.1-flash" },
        "task": { "provider": "opencode-go", "id": "deepseek-v4.1-flash" }
      },
      "mcpServers": []
    }
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "my-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BUTLER", "class_name": "ButlerDO" },
      { "name": "TASK", "class_name": "TaskDO" },
      { "name": "BOT", "class_name": "BotDO" },
      { "name": "BOT_CHAT", "class_name": "BotChatDO" },
      { "name": "TEST_HARNESS", "class_name": "TestHarnessDO" },
      { "name": "CHANNELS", "class_name": "ChannelDO" },
      { "name": "MCP_AUTH", "class_name": "McpAuthDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ButlerDO", "TaskDO", "TestHarnessDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChannelDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["BotDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["McpAuthDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["BotChatDO"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
