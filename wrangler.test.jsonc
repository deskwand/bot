{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot",
  "main": "tests/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "PUBLIC_BASE_URL": "https://example.com"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "my-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BUTLER", "class_name": "ButlerDO" },
      { "name": "TASK", "class_name": "TaskDO" },
      { "name": "TEST_HARNESS", "class_name": "TestHarnessDO" },
      { "name": "CHANNELS", "class_name": "ChannelDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ButlerDO", "TaskDO", "TestHarnessDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChannelDO"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
